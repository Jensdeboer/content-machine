{
  "$meta": {
    "name": "PaceVector design tokens",
    "version": "0.7",
    "source": "PaceVector Brand System.dc.html",
    "note": "Single source of truth. Every other file references role names. Hex codes appear only in this file."
  },
  "color": {
    "ground": {
      "value": "#FFFFFF",
      "source": "White",
      "role": "Default slide ground (information slides, light covers)"
    },
    "ground-alt": {
      "value": "#E9EEF3",
      "source": "Light",
      "role": "Secondary ground and image-panel fill (cool tint of navy)"
    },
    "ground-navy": {
      "value": "#062B49",
      "source": "Vector Navy",
      "role": "Flat navy ground for full-frame navy slides and covers"
    },
    "ground-deep": {
      "type": "gradient",
      "source": "Deep",
      "role": "Cover ground only. Soft light behind the figure.",
      "gradient": {
        "kind": "radial",
        "shape": "ellipse",
        "size": "75% 60%",
        "position": "50% 65%",
        "stops": [
          {
            "value": "#0C4272",
            "position": "0%"
          },
          {
            "value": "#041C30",
            "position": "100%"
          }
        ]
      }
    },
    "ink": {
      "value": "#000000",
      "source": "Black",
      "role": "Headlines and primary type on light grounds"
    },
    "ink-soft": {
      "value": "#222222",
      "source": "body copy ink on information slides",
      "role": "Body copy on light grounds"
    },
    "mute": {
      "value": "#5C6670",
      "source": "Slate",
      "role": "Secondary labels, kickers, SWIPE label"
    },
    "mute-inv": {
      "value": "#9AA7B4",
      "source": "Slate, inverted",
      "role": "Kickers and secondary labels on navy grounds"
    },
    "line": {
      "value": "#E6E6E2",
      "source": "Rule",
      "role": "Hairlines, dividers, grid rules"
    },
    "accent": {
      "value": "#062B49",
      "source": "Vector Navy",
      "role": "Accent ground, chips, mark, monument numerals"
    },
    "accent-ink": {
      "value": "#062B49",
      "source": "Vector Navy",
      "role": "Accent used as type colour on light grounds (numerals, mono labels, mark)"
    },
    "on-accent": {
      "value": "#FFFFFF",
      "source": "White",
      "role": "Type and mark placed on the accent ground"
    },
    "signal": {
      "value": "#D8FF47",
      "source": "Signal",
      "role": "Covers only. At most one element per cover. Never on a slide."
    }
  },
  "type": {
    "display": {
      "family": "Sora",
      "fallback": "sans-serif",
      "weights": {
        "bold": 800,
        "semi": 700
      },
      "tracking": {
        "monument": "-0.08em",
        "statement": "-0.06em",
        "headline": "-0.035em",
        "shout": "-0.12em"
      },
      "leading": {
        "tight": 0.95,
        "headline": 1.02
      }
    },
    "body": {
      "family": "IBM Plex Sans",
      "fallback": "sans-serif",
      "weights": {
        "regular": 400,
        "light-italic": 300
      },
      "leading": {
        "copy": 1.45,
        "aside": 1.3
      },
      "styles": {
        "aside": "italic"
      }
    },
    "data": {
      "family": "IBM Plex Mono",
      "fallback": "monospace",
      "weights": {
        "medium": 500
      },
      "tracking": {
        "label": "0.1em",
        "wide": "0.12em"
      },
      "transform": "uppercase"
    }
  },
  "size": {
